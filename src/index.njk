---
layout: base.njk
pagination:
  data: collections.posts
  size: 10
  alias: items
permalink: "{% if pagination.pageNumber > 0 %}/page/{{ pagination.pageNumber + 1 }}/{% else %}/{% endif %}"
---
{% include "postlist.njk" %}
{#- one button: the next (older) ten come in under these; without JavaScript it opens /page/2/ … -#}
{%- if pagination.href.next %}
<div class="more">
  <a class="ibtn" href="{{ pagination.href.next }}" data-more aria-label="نوشته‌های بیشتر" title="نوشته‌های بیشتر">{{ icons.down | safe }}</a>
</div>
{%- endif %}
