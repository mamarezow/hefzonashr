{%- extends "base.njk" -%}
{%- block main %}<div class="about"><h1 class="sr">{{ title }}</h1>{{ content | safe }}
<p class="social">{% for s in site.social %}<a class="ibtn" href="{{ s.url }}" target="_blank" rel="me noopener" aria-label="{{ s.name }}" title="{{ s.name }}">{{ icons[s.icon] | safe }}</a>{% endfor %}</p>
<form class="contact" id="contact" method="post" action="https://admin.hefzonashr.ir/contact" data-contact>
  <textarea name="message" required maxlength="4000" rows="4" placeholder="متن پیام" aria-label="متن پیام"></textarea>
  <input name="email" type="text" maxlength="254" dir="ltr" placeholder="ایمیل یا شناسه تلگرام" aria-label="ایمیل یا شناسه تلگرام" autocomplete="email" autocapitalize="off" spellcheck="false">
  <input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div class="row"><button class="tag" type="submit">ارسال پیام</button><span class="note" role="status" aria-live="polite"></span></div>
</form>
<nav class="tagrows" aria-label="برچسب‌ها">{% for row in site.tags | tagRows(collections.posts) %}<div>{% for k in row %}<a class="tag" href="/{{ k }}/">{{ site.tags[k] }}</a>{% endfor %}</div>{% endfor %}</nav></div>{% endblock %}
