{%- extends "base.njk" -%}
{%- block main %}<div class="about"><h1 class="sr">{{ title }}</h1>{{ content | safe }}
<p class="social">{% for s in site.social %}<a class="ibtn" href="{{ s.url }}" target="_blank" rel="me noopener" aria-label="{{ s.name }}" title="{{ s.name }}">{{ icons[s.icon] | safe }}</a>{% endfor %}</p></div>{% endblock %}
