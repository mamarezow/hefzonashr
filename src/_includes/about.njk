{%- extends "base.njk" -%}
{%- block main %}<div class="about"><h1 class="sr">{{ title }}</h1>{{ content | safe }}
<p class="social">{% for s in site.social %}<a class="ibtn" href="{{ s.url }}" target="_blank" rel="me noopener" aria-label="{{ s.name }}" title="{{ s.name }}">{{ icons[s.icon] | safe }}</a>{% endfor %}</p>
<nav class="tagrows" aria-label="برچسب‌ها">{% for row in site.tags | tagRows(collections.posts) %}<div>{% for k in row %}<a class="tag" href="/{{ k }}/">{{ site.tags[k] }}</a>{% endfor %}</div>{% endfor %}</nav></div>{% endblock %}
