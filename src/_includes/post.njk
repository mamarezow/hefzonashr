{%- extends "base.njk" -%}
{%- set ogType = "article" -%}
{%- set description = subtitle or "" -%}
{%- block meta %}
<meta property="article:published_time" content="{{ page.date | iso }}">
<meta property="article:author" content="{{ site.author }}">
<meta name="author" content="{{ site.author }}">
<meta property="telegram:channel" content="@hefzonashr">
{%- for k in tags %}{% if site.tags[k] %}
<meta property="article:tag" content="{{ site.tags[k] }}">{% endif %}{% endfor %}
{%- endblock %}
{%- block main %}
{%- set shortUrl = site.domain + "/p/" + telegram -%}
{%- set prev = collections.posts | older(page.url) -%}
{%- set next = collections.posts | newer(page.url) -%}
<article data-file="{{ page.fileSlug }}">{# the post's file, for the in-place editor on admin.hefzonashr.ir #}
  <header>
    <h1>{{ title }}</h1>
    {%- if subtitle %}
    <h2>{{ subtitle }}</h2>
    {%- endif %}
  </header>
  {%- if form == "poem" %}
  <div class="body poem">{{ page.rawInput | poemHtml | safe }}</div>
  {%- else %}
  <div class="body prose">{{ content | safe }}</div>
  {%- endif %}
  <footer class="postfoot">
    <div class="row">
      <span class="tags">{% for k in tags %}{% if site.tags[k] %}<a class="tag" href="/{{ k }}/" rel="tag">{{ site.tags[k] }}</a>{% endif %}{% endfor %}</span>
      {%- if telegram %}
      <button class="copy" type="button" data-copy="https://{{ shortUrl }}" aria-label="کپی لینک کوتاه">{{ icons.link | safe }}<span class="u">{{ shortUrl }}</span></button>
      {%- endif %}
    </div>
  </footer>
</article>
<nav class="pn" aria-label="نوشته‌های دیگر">
  {%- if prev %}<a class="ibtn" href="{{ prev.url }}" rel="prev" aria-label="نوشتهٔ قبلی: {{ prev.data.title }}" title="{{ prev.data.title }}">{{ icons.right | safe }}</a>
  {%- else %}<span class="ibtn off" aria-hidden="true">{{ icons.right | safe }}</span>{% endif %}
  <time class="when" datetime="{{ page.date | iso }}">{{ page.date | jdate }}</time>
  {%- if next %}<a class="ibtn" href="{{ next.url }}" rel="next" aria-label="نوشتهٔ بعدی: {{ next.data.title }}" title="{{ next.data.title }}">{{ icons.left | safe }}</a>
  {%- else %}<span class="ibtn off" aria-hidden="true">{{ icons.left | safe }}</span>{% endif %}
</nav>
{#- a comment goes to Mamareza's Telegram, like the message form on /me/ (admin/src/contact.js) #}
<form class="contact comment" id="comment" method="post" action="https://admin.hefzonashr.ir/contact" data-contact>
  <textarea name="message" dir="rtl" required maxlength="4000" rows="3" placeholder="متن کامنت شما" aria-label="متن کامنت شما"></textarea>
  <div class="row"><button class="tag" type="submit">ارسال پیام</button><input name="email" type="text" maxlength="254" dir="ltr" placeholder="ایمیل یا شناسه تلگرام (اختیاری)" aria-label="ایمیل یا شناسه تلگرام (اختیاری)" autocomplete="email" autocapitalize="off" spellcheck="false"></div>
  <span class="note" role="status" aria-live="polite"></span>
  <input type="hidden" name="post" value="{{ (site.domain + '/p/' + telegram) if telegram else (site.domain + page.url) }}">
  <input type="hidden" name="page" value="{{ page.url }}">
  <input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
</form>
{%- endblock %}
