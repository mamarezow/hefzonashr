---
pagination:
  data: collections.moved
  size: 1
  alias: moved
permalink: "{{ moved.from }}"
eleventyExcludeFromCollections: true
---
{#- a post's old address (/posts/<name>/, or its Finglish name from before 2026-10-10): same forwarding page as the
    short links, so shared links, search results and Instant View keep working -#}
{%- set post = moved.post -%}
{%- set target = site.url + post.url -%}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<title>{{ post.data.title }} | {{ site.title }}</title>
<link rel="canonical" href="{{ target }}">
<meta name="hefzonashr:file" content="{{ post.page.fileSlug }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ post.data.title }}">
<meta property="og:description" content="{{ post.data.subtitle or '' }}">
<meta property="og:url" content="{{ target }}">
<meta property="og:type" content="article">
<meta property="telegram:channel" content="@hefzonashr">
<meta http-equiv="refresh" content="0; url={{ post.url }}">
<meta name="robots" content="noindex">
<script>location.replace({{ post.url | dump | safe }})</script>
</head>
<body>
<article>
  <header>
    <h1><a href="{{ post.url }}">{{ post.data.title }}</a></h1>
    {%- if post.data.subtitle %}
    <h2>{{ post.data.subtitle }}</h2>
    {%- endif %}
  </header>
  {%- if post.data.form == "poem" %}
  <div class="body poem">{{ post.rawInput | poemHtml | safe }}</div>
  {%- else %}
  <div class="body prose">{{ post.content | safe }}</div>
  {%- endif %}
  <footer class="postfoot"><span><time datetime="{{ post.date | iso }}">{{ post.date | jdate }}</time></span></footer>
</article>
</body>
</html>
