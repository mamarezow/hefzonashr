---
layout: base.njk
pagination:
  data: site.tags
  size: 1
  alias: key
eleventyComputed:
  title: "{{ site.tagTitles[key] or site.tags[key] }}"
  pill: "/{{ key }}/"
permalink: "/{{ key }}/"
---
{#- no visible heading: the highlighted pill or the tag you clicked says where you are -#}
<h1 class="sr">{{ title }}</h1>
{%- set items = collections.posts | withTag(key) %}
{%- if items.length %}
{% include "postlist.njk" %}
{%- else %}
<p class="empty">هنوز نوشته‌ای اینجا نیست.</p>
{%- endif %}
