{
  "name": "hefzonashr-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // where the Telegram bot (src/bot.js) remembers each conversation
  "kv_namespaces": [{ "binding": "BOT", "id": "564adaad07744ebeabc424ae18d17bb0" }],
  // GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_TOKEN, TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set in the Cloudflare dashboard; keep them on deploy
  "keep_vars": true
}
